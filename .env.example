# AgroNova — root environment configuration
# Copy to .env and adjust for your environment.

# --- Backend ---
# SQLAlchemy connection string. SQLite is used locally; a PostgreSQL/PostGIS
# URL can be supplied through the same variable for deployment.
DATABASE_URL=sqlite:///./agronova.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Serve estimates from the bundled reference workspace when an upstream
# weather provider cannot be reached.
OFFLINE_FALLBACK=true

# Weather feed selection. "reference" is the built-in feed; point this at
# IMD, state department or other approved providers for operations.
WEATHER_PROVIDER=reference

# Credential for the configured weather provider. Leave empty for the
# built-in reference feed.
WEATHER_API_KEY=

# Runtime environment label.
APP_ENV=development

# --- Frontend ---
# Base URL the browser uses for API calls.
VITE_API_URL=http://localhost:8000/api

# Controls the browser-side reference workspace used when the API cannot be
# reached.
VITE_OFFLINE_FALLBACK=true
